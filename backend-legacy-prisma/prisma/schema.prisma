generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  seller
  buyer
  arbitrator
  nia
}

enum NIAVerificationStatus {
  not_submitted
  pending
  verified
  rejected
}

enum EmployeeVerificationDecision {
  granted
  denied
  flagged
}

enum EmployeeVerificationStep {
  employee_identification
  card_authentication
  biometric_match
  internal_staff_validation
  access_decision
}

enum VerificationStatus {
  verified
  pending
  rejected
}

enum PendingRegistrationStatus {
  pending
  approved
  rejected
}

enum ParcelStatus {
  available
  pending
  sold
  disputed
}

enum ParcelType {
  residential
  commercial
  agricultural
  industrial
}

enum DocVerificationStatus {
  pending
  verified
  rejected
}

enum TransferStatus {
  pending
  completed
  cancelled
}

enum PaymentStatus {
  pending
  processing
  success
  failed
  abandoned
}

enum PaystackPaymentChannel {
  mobile_money
  bank
}

enum DisputeStatus {
  filed
  pending
  under_review
  community_voting
  resolved
}

enum VoteType {
  support
  against
  abstain
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phoneNumber       String
  passwordHash      String
  role              Role
  verificationStatus VerificationStatus @default(pending)
  country           String   @default("GH")
  organization      String?
  staffId           String?
  arbitratorRegNo   String?
  blockchainToken   String?  @unique
  idVerification    String?  // JSON
  niaStatus         NIAVerificationStatus @default(not_submitted)
  niaReferenceId    String?
  niaVerifiedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reputation        UserReputation?
  creditScore       UserCreditScore?
  financialProfile  UserFinancialProfile?
  ownedParcels      LandParcel[]          @relation("ParcelOwner")
  parcelsCommented  LandParcelComment[]
  notifications     Notification[]
  transfersFrom     Transfer[]             @relation("TransferFrom")
  transfersTo       Transfer[]             @relation("TransferTo")
  disputeVotes      DisputeVote[]
  disputesAsPlaintiff Dispute[] @relation("DisputePlaintiff")
  disputesAsDefendant Dispute[] @relation("DisputeDefendant")
  reviewedRegistrations PendingRegistration[] @relation("ReviewedBy")
  paymentsAsBuyer     Payment[] @relation("PaymentBuyer")
  paymentsAsSeller    Payment[] @relation("PaymentSeller")
  conversationsAsBuyer Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messagesSent         Message[]
  employeeVerificationAttempts EmployeeVerificationAttempt[]
}

model UserReputation {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score                 Int      @default(0)
  totalTransactions     Int      @default(0)
  successfulTransactions Int    @default(0)
  disputesWon           Int      @default(0)
  communityVotes        Int      @default(0)
  updatedAt             DateTime @updatedAt
}

model UserCreditScore {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score             Int      @default(650)
  rating            String   @default("Fair")
  paymentHistory    Int      @default(70)
  creditUtilization Int      @default(45)
  lengthOfHistory   Int      @default(60)
  newCredit         Int      @default(55)
  creditMix         Int      @default(65)
  updatedAt         DateTime @updatedAt
}

model UserFinancialProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyIncome   Float    @default(0)
  assets          Float    @default(0)
  liabilities     Float    @default(0)
  netWorth        Float    @default(0)
  bankingHistory  Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model PendingRegistration {
  id              String   @id @default(cuid())
  name            String
  email           String
  phoneNumber     String
  role            Role
  organization    String?
  passwordHash    String
  staffId         String?
  arbitratorRegNo String?
  status          PendingRegistrationStatus @default(pending)
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?    @relation("ReviewedBy", fields: [reviewedById], references: [id])
  rejectionReason String?

  ghanaCard       GhanaCard?
  landDocuments   RegistrationLandDocument[]
}

model GhanaCard {
  id                    String   @id @default(cuid())
  pendingRegistrationId String   @unique
  pendingRegistration   PendingRegistration @relation(fields: [pendingRegistrationId], references: [id], onDelete: Cascade)
  frontCardImage        String
  backCardImage         String
  faceImage             String
  cardNumber            String
  fullName              String
  faceMatchPassed       Boolean  @default(false)
  createdAt             DateTime @default(now())
}

model RegistrationLandDocument {
  id                    String   @id @default(cuid())
  pendingRegistrationId String
  pendingRegistration   PendingRegistration @relation(fields: [pendingRegistrationId], references: [id], onDelete: Cascade)
  name                  String
  type                  String
  scannedImage          String
  size                  Int      @default(0)
  uploadedAt            DateTime @default(now())
}

model LandParcel {
  id                        String   @id @default(cuid())
  title                     String
  description               String
  ownerId                   String
  owner                     User     @relation("ParcelOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  area                      Float
  price                     Float
  status                    ParcelStatus @default(available)
  type                      ParcelType
  documentsVerificationStatus DocVerificationStatus? @default(pending)
  blockchainHash            String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  location          LandParcelLocation?
  documents         LandParcelDocument[]
  images            LandParcelImage[]
  comments          LandParcelComment[]
  transfers         Transfer[]
  disputes          Dispute[]
  payments          Payment[]
  conversations     Conversation[]
}

model LandParcelLocation {
  id          String   @id @default(cuid())
  landParcelId String  @unique
  landParcel  LandParcel @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  address     String
  latitude    Float
  longitude   Float
  region      String
}

model LandParcelDocument {
  id                String   @id @default(cuid())
  landParcelId      String
  landParcel        LandParcel @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  name              String
  type              String
  url               String
  verificationStatus DocVerificationStatus @default(pending)
  verifiedById      String?
  verifiedAt        DateTime?
  uploadedAt        DateTime @default(now())
}

model LandParcelImage {
  id          String   @id @default(cuid())
  landParcelId String
  landParcel  LandParcel @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  url         String
  caption     String?
  type        String   @default("main")
  size        Int      @default(0)
  displayOrder Int     @default(0)
  uploadedAt  DateTime @default(now())
}

model LandParcelComment {
  id          String   @id @default(cuid())
  landParcelId String
  landParcel  LandParcel @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Transfer {
  id            String   @id @default(cuid())
  landParcelId  String
  landParcel    LandParcel @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  fromUserId    String
  fromUser      User     @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUserId      String
  toUser        User     @relation("TransferTo", fields: [toUserId], references: [id])
  amount        Float
  status        TransferStatus @default(pending)
  initiatedDate DateTime @default(now())
  completedDate DateTime?
  escrowAmount  Float?
  /** Paystack payment reference (fiat); primary receipt for buyers */
  transactionHash String?
  /** Optional: tx hash after backend anchors sale on-chain (no crypto required from user) */
  chainTxHash     String?
  chainNetwork    String?
  chainSaleId     String?
  chainAnchoredAt DateTime?
  payment       Payment?
}

model Payment {
  id                 String               @id @default(cuid())
  reference          String               @unique
  paystackReference  String?
  amount             Float
  currency           String               @default("GHS")
  amountPesewas      Int
  status             PaymentStatus        @default(pending)
  channel            PaystackPaymentChannel
  buyerId            String
  buyer              User                 @relation("PaymentBuyer", fields: [buyerId], references: [id])
  sellerId           String
  seller             User                 @relation("PaymentSeller", fields: [sellerId], references: [id])
  landParcelId       String
  landParcel         LandParcel           @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  transferId         String?              @unique
  transfer           Transfer?            @relation(fields: [transferId], references: [id])
  paystackPayload    String?              @db.Text
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([buyerId, status])
  @@index([landParcelId, status])
}

model Dispute {
  id            String   @id @default(cuid())
  landParcelId  String
  landParcel    LandParcel @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  plaintiffUserId String
  plaintiff    User     @relation("DisputePlaintiff", fields: [plaintiffUserId], references: [id])
  defendantUserId String
  defendant    User     @relation("DisputeDefendant", fields: [defendantUserId], references: [id])
  description   String
  status        DisputeStatus @default(filed)
  filedDate     DateTime @default(now())
  votingDeadline DateTime?
  resolution    String?
  resolvedAt    DateTime?
  supportVotes  Int      @default(0)
  againstVotes Int      @default(0)
  abstainVotes Int      @default(0)

  evidence      DisputeEvidence[]
  votes         DisputeVote[]
}

model DisputeEvidence {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  uploadedAt DateTime @default(now())
}

model DisputeVote {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vote      VoteType
  votedAt   DateTime @default(now())

  @@unique([disputeId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  category  String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
}

model Conversation {
  id          String   @id @default(cuid())
  landParcelId String
  landParcel  LandParcel @relation(fields: [landParcelId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User     @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]

  @@unique([landParcelId, buyerId, sellerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String   @db.Text
  createdAt      DateTime @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model NIAEmployee {
  id          String   @id @default(cuid())
  staffId     String   @unique
  fullName    String
  department  String
  roleTitle   String
  active      Boolean  @default(true)
  ghanaCardNumber String
  /** Hash-like placeholder for demo biometric reference (not real biometrics) */
  biometricRef String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts    EmployeeVerificationAttempt[]
}

model EmployeeVerificationAttempt {
  id            String   @id @default(cuid())
  niaOfficerId  String
  niaOfficer    User     @relation(fields: [niaOfficerId], references: [id], onDelete: Cascade)

  staffId       String
  ghanaCardNumber String
  stepReached   EmployeeVerificationStep @default(employee_identification)
  decision      EmployeeVerificationDecision?
  flaggedReason String?

  details       String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employeeId    String?
  employee      NIAEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([niaOfficerId, createdAt])
  @@index([staffId, createdAt])
}

# SmartLand API — copy to `.env` and adjust.

PORT=3001
BIND_HOST=0.0.0.0
JWT_SECRET=change-me-in-production

# Frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (optional; omit to run fully in-memory) ---
# Option A: connection URL (Neon, Railway, Supabase, RDS, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL=true

# Option B: discrete vars
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=smartland
# DB_PASSWORD=smartland
# DB_NAME=smartland

# Snapshot flush interval (ms) when Postgres is enabled
# DB_SNAPSHOT_INTERVAL_MS=8000

# DB_POOL_MAX=10

# Supabase PostgreSQL — pooled connection (PgBouncer) for runtime
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection for schema migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"
PORT=3001
JWT_SECRET="your-secret-key-change-in-production"
NIA_BASE_URL=
NIA_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SmartLand <no-reply@smartland.local>"

# Paystack (Ghana GHS) — land purchase checkout; use test keys in development
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"
# Public URL of the frontend (Paystack redirect after payment)
FRONTEND_URL="http://localhost:5173"

# Optional: anchor Paystack-completed sales on-chain (registrar wallet — buyers stay on fiat)
CHAIN_RPC_URL=
CHAIN_REGISTRAR_PRIVATE_KEY=
LAND_SALE_ANCHOR_CONTRACT_ADDRESS=
CHAIN_NETWORK_NAME=polygon-amoy
CHAIN_EXPLORER_TX_BASE=https://amoy.polygonscan.com/tx/

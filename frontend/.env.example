# SmartLand API base URL (backend must be running)
VITE_API_URL=http://localhost:3001/api

# Supabase — Settings → API (publishable / anon key).
# With envPrefix in vite.config.ts, both Next-style and Vite names work:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Prefer gitignored `.env.local` for real keys (see Supabase dashboard).

# Optional: click-to-call numbers shown in in-app chat (uses tel:)
VITE_LANDS_COMMISSION_PHONE=+233302123456
VITE_ARBITRATOR_PHONE=+233244567890

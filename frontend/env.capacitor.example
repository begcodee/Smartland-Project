# Copy to .env.capacitor.local (do not commit secrets) and build:
#   npm run build:capacitor -- --mode capacitor
# Or inline:
#   set VITE_API_URL=http://YOUR_PC_LAN_IP:3001
#
# Android emulator → API on your PC:
#   VITE_API_URL=http://10.0.2.2:3001
#
# Physical Android/iPhone on same Wi‑Fi:
#   VITE_API_URL=http://192.168.x.x:3001
#
VITE_API_URL=http://10.0.2.2:3001
